---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Le Veilleur',
  description = 'Veille technologique quotidienne — articles générés depuis les meilleures newsletters tech.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pageTitle = title === 'Le Veilleur' ? title : `${title} — Le Veilleur`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,900;1,700;1,900&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/placeholder-veilleur.svg`} />
  </head>
  <body class="bg-background-light font-sans text-slate-900 min-h-screen flex flex-col antialiased">

    <header class="sticky top-0 z-50 bg-slate-900 text-white px-4 md:px-20 py-4 shadow-lg">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href={base} class="flex items-center gap-4 hover:opacity-90 transition-opacity">
          <div class="h-10 w-10 bg-primary rounded-full flex items-center justify-center text-lg overflow-hidden">
            🦉
          </div>
          <span class="text-xl font-black tracking-tighter uppercase">Le Veilleur</span>
        </a>

        <nav class="hidden md:flex items-center gap-8" aria-label="Navigation principale">
          <a href={base} class="text-sm font-medium hover:text-primary transition-colors">Articles</a>
          <a href={`${base}/trends`} class="text-sm font-medium hover:text-primary transition-colors">Tendances</a>
        </nav>
      </div>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 py-6 px-4 md:px-20">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <a href={base} class="flex items-center gap-4 hover:opacity-90 transition-opacity">
          <div class="h-8 w-8 bg-primary/20 rounded-full flex items-center justify-center text-base">
            🦉
          </div>
          <span class="font-bold text-white tracking-widest uppercase text-sm">Le Veilleur</span>
        </a>

        <nav class="flex items-center gap-6 text-sm" aria-label="Navigation secondaire">
          <a href={`${base}/confidentialite`} class="hover:text-white transition-colors">Confidentialité</a>
          <a href={`${base}/mentions-legales`} class="hover:text-white transition-colors">Mentions Légales</a>
          <a href={`${base}/newsletter`} class="hover:text-white transition-colors">Newsletter</a>
          <a href={`${base}/contact`} class="hover:text-white transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <a href={`${base}/rss.xml`} class="h-9 w-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" aria-label="Flux RSS">
            <svg class="w-4 h-4 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
          </a>
        </div>
      </div>
    </footer>

  </body>
</html>
