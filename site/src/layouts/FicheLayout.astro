---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  url: string;
  authors?: string[];
  keywords: string[];
  theme: string;
  tone?: string;
  used_in: string[];
  body?: string;
}

const { title, date, url, authors, keywords, theme, tone, used_in, body } = Astro.props;

const base = import.meta.env.BASE_URL;

const parentDate = used_in[0] ?? null;

function getDomain(url: string): string {
  try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

const domain = getDomain(url);

// Parse body sections
function extractSection(text: string | undefined, heading: string): string {
  if (!text) return '';
  const regex = new RegExp(`## ${heading}\\n\\n([\\s\\S]*?)(?=\\n## |$)`);
  const match = text.match(regex);
  return match ? match[1].trim() : '';
}

function extractListItems(text: string): string[] {
  return text.split('\n').filter((l) => l.startsWith('- ')).map((l) => l.slice(2).trim());
}

const summary = extractSection(body, 'Résumé');
const whyItMatters = extractSection(body, 'Pourquoi ça compte');
const keyPointsRaw = extractSection(body, 'Points clés');
const keyPoints = extractListItems(keyPointsRaw);
const translation = extractSection(body, 'Traduction française');
---

<BaseLayout title={title}>
  <div class="w-full max-w-4xl px-6 py-12 mx-auto">

    {/* Back link */}
    {parentDate ? (
      <a
        href={`${base}/articles/${parentDate}`}
        class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-primary transition-colors mb-8 focus:outline-none focus:ring-2 focus:ring-primary rounded"
      >
        ← Article du {new Date(parentDate + 'T00:00:00').toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' })}
      </a>
    ) : (
      <a
        href={base}
        class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-primary transition-colors mb-8 focus:outline-none focus:ring-2 focus:ring-primary rounded"
      >
        ← Retour aux articles
      </a>
    )}

    {/* Header */}
    <header class="mb-10">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-primary text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5 rounded-full mb-4 hover:bg-primary/90 transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
      >
        Article original&nbsp;: {domain}
      </a>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 leading-[1.1] tracking-tight mb-4">
        {title}
      </h1>

      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary hover:underline transition-colors focus:outline-none focus:ring-2 focus:ring-primary rounded"
      >
        🔗 Consulter la source originale
      </a>

      {/* Metadata grid */}
      <dl class="grid grid-cols-2 md:grid-cols-4 border border-slate-200 rounded-lg mt-6 divide-x divide-y md:divide-y-0 divide-slate-200">
        {authors && authors.length > 0 && (
          <div class="px-4 py-3">
            <dt class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Auteur{authors.length > 1 ? 's' : ''}</dt>
            <dd class="text-sm text-slate-900">{authors.join(', ')}</dd>
          </div>
        )}
        <div class="px-4 py-3">
          <dt class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Thème</dt>
          <dd class="text-sm text-slate-900">{theme}</dd>
        </div>
        {keywords.length > 0 && (
          <div class="px-4 py-3">
            <dt class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Mots-clés</dt>
            <dd class="text-sm text-slate-900">{keywords.join(', ')}</dd>
          </div>
        )}
        {tone && (
          <div class="px-4 py-3">
            <dt class="text-xs font-bold text-primary uppercase tracking-wider mb-1">Ton</dt>
            <dd class="text-sm text-slate-900 capitalize">{tone}</dd>
          </div>
        )}
      </dl>
    </header>

    {/* Résumé */}
    {summary && (
      <section class="mb-10">
        <h2 class="text-2xl font-black text-slate-900 tracking-tight mb-1">Résumé</h2>
        <div class="w-16 h-1 bg-primary rounded-full mb-6"></div>
        <div class="text-slate-700 leading-relaxed space-y-4">
          {summary.split('\n\n').map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    )}

    {/* Pourquoi ça compte — callout */}
    {whyItMatters && (
      <section class="bg-amber-50/70 border-l-4 border-primary rounded-r-lg px-6 py-5 mb-10">
        <h2 class="flex items-center gap-2 text-sm font-black uppercase tracking-wider text-slate-900 mb-2">
          💡 Pourquoi ça compte
        </h2>
        <p class="text-slate-700 italic leading-relaxed">{whyItMatters}</p>
      </section>
    )}

    {/* Two-column: Traduction + Points clés */}
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 mb-10">

      {/* Left — Traduction française */}
      {translation && (
        <div class="lg:col-span-3">
          <h2 class="text-2xl font-black text-slate-900 tracking-tight mb-1">Traduction Française</h2>
          <div class="w-16 h-1 bg-primary rounded-full mb-6"></div>
          <div class="text-slate-700 leading-relaxed space-y-4">
            {translation.split('\n\n').map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      )}

      {/* Right — Points clés */}
      {keyPoints.length > 0 && (
        <aside class={translation ? 'lg:col-span-2' : 'lg:col-span-5'}>
          <div class="border border-slate-200 rounded-lg p-5">
            <h2 class="flex items-center gap-2 text-lg font-black text-slate-900 mb-4">
              ❕ Points Clés
            </h2>
            <ul class="space-y-3">
              {keyPoints.map((point) => (
                <li class="flex gap-3 text-sm text-slate-700 leading-relaxed">
                  <span class="mt-1.5 size-2 rounded-full bg-primary shrink-0"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>

    {/* Utilisée dans */}
    {used_in.length > 0 && (
      <aside class="border-t border-slate-200 pt-8">
        <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">
          Utilisée dans
        </h2>
        <ul class="flex flex-wrap gap-3">
          {used_in.map((articleDate) => (
            <li>
              <a
                href={`${base}/articles/${articleDate}`}
                class="text-sm text-navy-custom hover:text-primary underline transition-colors focus:outline-none focus:ring-2 focus:ring-primary rounded"
              >
                Article du {new Date(articleDate + 'T00:00:00').toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' })}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>
