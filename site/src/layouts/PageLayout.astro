---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}

const { title, subtitle, image } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={title}>
  {/* Hero */}
  {image ? (
    <section class="w-full bg-slate-200">
      <div class="aspect-[16/9] w-full max-h-[50vh] relative overflow-hidden">
        <img
          src={`${base}/images/${image}`}
          alt={title}
          class="w-full h-full object-cover"
          width="1600"
          height="900"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-background-dark/80 to-transparent"></div>
      </div>
    </section>
  ) : (
    <section class="w-full bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-10 left-1/4 w-72 h-72 bg-primary rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-1/3 w-96 h-96 bg-primary/50 rounded-full blur-3xl"></div>
      </div>
      <div class="max-w-[800px] mx-auto px-6 pt-20 pb-32 relative z-10">
        <h1 class="text-4xl md:text-5xl font-black text-white leading-tight tracking-tight">{title}</h1>
        {subtitle && <p class="text-lg text-slate-300 mt-4">{subtitle}</p>}
      </div>
    </section>
  )}

  {/* Content card — overlapping the hero */}
  <div class={`max-w-[800px] mx-auto px-4 relative z-10 bg-background-light rounded-t-3xl pt-12 pb-20 ${image ? '-mt-24' : '-mt-16'}`}>
    {image && (
      <>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 leading-tight tracking-tight mb-2">{title}</h1>
        {subtitle && <p class="text-lg text-slate-500 mb-10">{subtitle}</p>}
      </>
    )}
    <div class="prose prose-slate max-w-none text-lg
      prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900
      prose-h2:text-2xl prose-h2:pt-6
      prose-a:text-primary prose-a:underline prose-a:decoration-primary/30 hover:prose-a:decoration-primary
      prose-p:text-slate-700 prose-p:leading-relaxed
      prose-li:text-slate-700">
      <slot />
    </div>
  </div>
</BaseLayout>
