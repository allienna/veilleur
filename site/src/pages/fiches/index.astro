---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FicheCard from '../../components/FicheCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const allFiches = await getCollection('fiches');
const allArticles = await getCollection('articles');

const articleTitles: Record<string, string> = {};
for (const article of allArticles) {
  const dateStr = article.data.date.toISOString().slice(0, 10);
  articleTitles[dateStr] = article.data.title;
}

function extractSummary(body: string | undefined): string {
  if (!body) return '';
  const match = body.match(/## Résumé\n\n(.+?)(?:\n\n|$)/s);
  return match ? match[1].trim() : '';
}

const sortedFiches = allFiches.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Analyses des sources">
  <div class="w-full max-w-6xl px-6 py-12 mx-auto">

    <nav id="breadcrumb" class="hidden flex items-center gap-2 text-sm mb-8">
      <a href={base} class="text-slate-500 hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
        </svg>
      </a>
      <span class="text-slate-300">›</span>
      <a id="bc-article" href="#" class="text-slate-500 hover:text-primary transition-colors">…</a>
      <span class="text-slate-300">›</span>
      <span class="text-slate-900 font-medium">Analyses</span>
    </nav>

    <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mb-4">
      <span id="page-title-prefix">Analyses des sources</span><span id="article-title-suffix" class="text-primary italic"></span>
    </h1>
    <p class="text-lg text-slate-500 mb-12">
      Retrouvez ici l'ensemble des sources décortiquées, synthétisées et vérifiées par notre comité d'experts en intelligence artificielle.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedFiches.map((fiche) => (
        <FicheCard
          slug={fiche.slug}
          title={fiche.data.title}
          url={fiche.data.url}
          theme={fiche.data.theme}
          summary={extractSummary(fiche.body)}
          usedIn={fiche.data.used_in}
        />
      ))}
    </div>
  </div>

  <script define:vars={{ base, articleTitles }}>
    const params = new URLSearchParams(window.location.search);
    const articleDate = params.get('article');
    if (articleDate) {
      const breadcrumb = document.getElementById('breadcrumb');
      const bcArticle = document.getElementById('bc-article');
      if (breadcrumb && bcArticle) {
        const formatted = new Date(articleDate + 'T00:00:00').toLocaleDateString('fr-FR', {
          day: '2-digit', month: 'long', year: 'numeric',
        });
        bcArticle.href = `${base}/articles/${articleDate}`;
        bcArticle.textContent = `Article du ${formatted}`;
        breadcrumb.classList.remove('hidden');
      }

      const titlePrefix = document.getElementById('page-title-prefix');
      const titleSuffix = document.getElementById('article-title-suffix');
      const title = articleTitles[articleDate];
      if (titlePrefix && titleSuffix && title) {
        titlePrefix.textContent = 'Analyses de l\u2019article\u00a0: ';
        titleSuffix.textContent = title;
      }

      document.querySelectorAll('.fiche-card').forEach((card) => {
        const usedIn = card.getAttribute('data-used-in') || '';
        if (!usedIn.split(',').includes(articleDate)) {
          card.remove();
        }
      });
    }
  </script>
</BaseLayout>
