---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagPill from '../../components/TagPill.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const allFiches = await getCollection('fiches');

function extractSummary(body: string | undefined): string {
  if (!body) return '';
  const match = body.match(/## Résumé\n\n(.+?)(?:\n\n|$)/s);
  return match ? match[1].trim() : '';
}

function getDomain(url: string): string {
  try { return new URL(url).hostname.replace('www.', ''); } catch { return ''; }
}

const sortedFiches = allFiches.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);

const themeGradients: Record<string, string> = {
  'IA': 'from-amber-50 to-orange-50',
  'Sécurité': 'from-red-50 to-rose-50',
  'Leadership': 'from-blue-50 to-indigo-50',
  'Tech': 'from-emerald-50 to-teal-50',
};
---

<BaseLayout title="Analyses des sources">
  <div class="w-full max-w-6xl px-6 py-12 mx-auto">

    <a
      id="back-link"
      href={base}
      class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-primary transition-colors mb-8 focus:outline-none focus:ring-2 focus:ring-primary rounded"
    >
      ← Retour aux articles
    </a>

    <h1 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mb-4">
      Analyses des sources
    </h1>
    <p class="text-lg text-slate-500 mb-12">
      Fiches de synthèse des articles analysés dans la veille.
    </p>

    <p class="text-slate-500 text-center py-20">Bientôt disponible.</p>
  </div>

  <script define:vars={{ base }}>
    const params = new URLSearchParams(window.location.search);
    const articleDate = params.get('article');
    if (articleDate) {
      const backLink = document.getElementById('back-link');
      if (backLink) {
        const formatted = new Date(articleDate + 'T00:00:00').toLocaleDateString('fr-FR', {
          day: '2-digit', month: 'long', year: 'numeric',
        });
        backLink.href = `${base}/articles/${articleDate}`;
        backLink.textContent = `\u2190 Consulter l'article du ${formatted}`;
      }

      document.querySelectorAll('.fiche-card').forEach((card) => {
        const usedIn = card.getAttribute('data-used-in') || '';
        if (!usedIn.split(',').includes(articleDate)) {
          card.remove();
        }
      });
    }
  </script>
</BaseLayout>
