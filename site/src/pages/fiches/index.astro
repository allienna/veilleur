---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FicheCard from '../../components/FicheCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const allFiches = await getCollection('fiches');
const allArticles = await getCollection('articles');

const articleTitles: Record<string, string> = {};
for (const article of allArticles) {
  const dateStr = article.data.date.toISOString().slice(0, 10);
  articleTitles[dateStr] = article.data.title;
}

function extractSummary(body: string | undefined): string {
  if (!body) return '';
  const match = body.match(/## Résumé\n\n(.+?)(?:\n\n|$)/s);
  return match ? match[1].trim() : '';
}

const sortedFiches = allFiches.sort((a, b) =>
  b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Analyses des sources">
  <div class="w-full max-w-6xl px-6 py-12 mx-auto">

    <a
      id="back-link"
      href={base}
      class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-primary transition-colors mb-8 focus:outline-none focus:ring-2 focus:ring-primary rounded"
    >
      ← Retour aux articles
    </a>

    <h1 id="page-title" class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mb-4">
      Analyses des sources<span id="article-title-suffix" class="text-primary italic"></span>
    </h1>
    <p class="text-lg text-slate-500 mb-12">
      Retrouvez ici l'ensemble des sources décortiquées, synthétisées et vérifiées par notre comité d'experts en intelligence artificielle.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedFiches.map((fiche) => (
        <FicheCard
          slug={fiche.slug}
          title={fiche.data.title}
          url={fiche.data.url}
          theme={fiche.data.theme}
          summary={extractSummary(fiche.body)}
          usedIn={fiche.data.used_in}
        />
      ))}
    </div>
  </div>

  <script define:vars={{ base, articleTitles }}>
    const params = new URLSearchParams(window.location.search);
    const articleDate = params.get('article');
    if (articleDate) {
      const backLink = document.getElementById('back-link');
      if (backLink) {
        const formatted = new Date(articleDate + 'T00:00:00').toLocaleDateString('fr-FR', {
          day: '2-digit', month: 'long', year: 'numeric',
        });
        backLink.href = `${base}/articles/${articleDate}`;
        backLink.textContent = `\u2190 Consulter l'article du ${formatted}`;
      }

      const titleSuffix = document.getElementById('article-title-suffix');
      const title = articleTitles[articleDate];
      if (titleSuffix && title) {
        document.getElementById('page-title').childNodes[0].textContent = 'Analyses de l\u2019article\u00a0: ';
        titleSuffix.textContent = title;
      }

      document.querySelectorAll('.fiche-card').forEach((card) => {
        const usedIn = card.getAttribute('data-used-in') || '';
        if (!usedIn.split(',').includes(articleDate)) {
          card.remove();
        }
      });
    }
  </script>
</BaseLayout>
