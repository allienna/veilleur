---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const [articles, fiches] = await Promise.all([
    getCollection('articles'),
    getCollection('fiches'),
  ]);

  // Collect all tags from articles (themes) and fiches (keywords + theme)
  const tagMap = new Map<string, { articles: typeof articles; fiches: typeof fiches }>();

  const addTag = (tag: string) => {
    const key = tag.toLowerCase().replace(/\s+/g, '-');
    if (!tagMap.has(key)) {
      tagMap.set(key, { articles: [], fiches: [] });
    }
    return key;
  };

  for (const article of articles) {
    for (const theme of article.data.themes) {
      const key = addTag(theme);
      tagMap.get(key)!.articles.push(article);
    }
  }

  for (const fiche of fiches) {
    const themeKey = addTag(fiche.data.theme);
    tagMap.get(themeKey)!.fiches.push(fiche);

    for (const kw of fiche.data.keywords) {
      const key = addTag(kw);
      tagMap.get(key)!.fiches.push(fiche);
    }
  }

  return Array.from(tagMap.entries()).map(([tag, data]) => ({
    params: { tag },
    props: {
      tagLabel: tag,
      matchedArticles: data.articles.sort(
        (a, b) => b.data.date.getTime() - a.data.date.getTime()
      ),
      matchedFiches: data.fiches,
    },
  }));
}

interface Props {
  tagLabel: string;
  matchedArticles: Awaited<ReturnType<typeof getCollection<'articles'>>>;
  matchedFiches: Awaited<ReturnType<typeof getCollection<'fiches'>>>;
}

const { tagLabel, matchedArticles, matchedFiches } = Astro.props;

const base = import.meta.env.BASE_URL;

// Human-readable label from slug
const displayLabel = tagLabel.replace(/-/g, ' ');
---

<BaseLayout title={`Tag : ${displayLabel}`}>
  <div class="space-y-10">
    <header class="pb-6 border-b border-gray-200">
      <p class="text-sm text-gray-500 mb-1">Tag</p>
      <h1 class="text-3xl font-bold text-navy-900 capitalize">{displayLabel}</h1>
      <p class="text-gray-600 mt-2">
        {matchedArticles.length} article{matchedArticles.length !== 1 ? 's' : ''}
        {matchedFiches.length > 0 && `, ${matchedFiches.length} fiche${matchedFiches.length !== 1 ? 's' : ''}`}
      </p>
    </header>

    {matchedArticles.length > 0 && (
      <section aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="text-xl font-bold text-navy-900 mb-4">Articles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {matchedArticles.map((article) => (
            <ArticleCard
              slug={article.slug}
              title={article.data.title}
              date={article.data.date}
              themes={article.data.themes}
              sources={article.data.sources}
              image={article.data.image}
            />
          ))}
        </div>
      </section>
    )}

    {matchedFiches.length > 0 && (
      <section aria-labelledby="fiches-heading">
        <h2 id="fiches-heading" class="text-xl font-bold text-navy-900 mb-4">Fiches sources</h2>
        <ul class="space-y-3">
          {matchedFiches.map((fiche) => (
            <li>
              <a
                href={`${base}/fiches/${fiche.slug}`}
                class="group flex items-start gap-3 p-4 rounded-lg border border-gray-200
                  hover:border-navy-300 hover:bg-navy-50 transition-colors
                  focus:outline-none focus:ring-2 focus:ring-amber-400"
              >
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-navy-800 group-hover:text-navy-900">
                    {fiche.data.title}
                  </p>
                  <p class="text-sm text-gray-500 truncate mt-0.5">{fiche.data.url}</p>
                </div>
                <span class="shrink-0 text-xs bg-navy-100 text-navy-700 px-2 py-0.5 rounded-full self-start mt-0.5">
                  {fiche.data.theme}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {matchedArticles.length === 0 && matchedFiches.length === 0 && (
      <p class="text-gray-500 text-center py-12">Aucun contenu trouvé pour ce tag.</p>
    )}
  </div>
</BaseLayout>
