---
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
const base = import.meta.env.BASE_URL;
const linkHref = href ?? `${base}/tags/${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, '-').replace(/\//g, '-'))}`;
---

<a
  href={linkHref}
  class="bg-primary/20 text-primary px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider hover:bg-primary/30 transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
>
  {tag}
</a>
